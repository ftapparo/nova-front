# =============================================================================
# FRONT — variáveis de build (Vite)
#
# IMPORTANTE: tudo com prefixo VITE_ é embutido no bundle JavaScript e fica
# visível para quem abrir o DevTools. NADA aqui é segredo.
#
# A proteção real do painel é o Cloudflare Access na borda, que autentica
# antes de a aplicação carregar.
# =============================================================================

# Durante a migração de domínio, aponte para o domínio que estiver ativo.
# Novo:    https://api.novaresidence.com.br/v2/api
# Antigo:  https://api.condominionovaresidence.com/v2/api
VITE_API_BASE_URL=https://api.novaresidence.com.br/v2/api

# Credencial do seletor de operador. Ver o comentário em
# src/contexts/AuthContext.tsx sobre por que isto não é controle de segurança.
# Substituído por login real contra a API na Etapa 2.
VITE_AUTH_USER=portaria
VITE_AUTH_PASS=
