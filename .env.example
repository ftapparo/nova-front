# =============================================================================
# FRONT_V3 — configuração local de desenvolvimento
#
# O painel fala sempre com a própria origem (/v3/api e /v3/ws). Em
# desenvolvimento o Vite repassa /v3 para o endereço abaixo; em produção quem
# repassa é o nginx do container. Por isso não existe VITE_API_BASE_URL.
#
# IMPORTANTE: tudo com prefixo VITE_ é embutido no bundle JavaScript e fica
# visível no DevTools. Nunca colocar segredo em variável VITE_.
# =============================================================================

# Endereço da nova-api v3 visto da máquina de desenvolvimento (rede interna/VPN).
# Sem esta variável o proxy não é criado e as chamadas a /v3 não chegam à API.
# Atenção: aponta para a API real — comandos acionam portões, portas,
# exaustores e a central de incêndio de verdade.
V3_PROXY_TARGET=http://192.168.0.250:3031
